<Window x:Class="MarketPrenga.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarketPrenga.ViewModels"
        Title="Market Prenga" Width="1280" Height="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1F2A44" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Market Prenga" Foreground="White" FontSize="20" FontWeight="Bold" Margin="4,6,4,2"/>
                    <TextBlock Text="{Binding UserLabel}" Foreground="#AAB4CC" FontSize="12" Margin="4,0,4,16"/>
                    <Button Content="Shitja" Command="{Binding ShowShitjaCommand}"/>
                    <Button Content="Artikuj" Command="{Binding ShowArtikujCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Klientë" Command="{Binding ShowKlientetCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="12"/>
    </Grid>
</Window>
