<Application x:Class="MarketPrenga.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MarketPrenga.ViewModels"
             xmlns:v="clr-namespace:MarketPrenga.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShitjaViewModel}"><v:ShitjaView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FaturatViewModel}"><v:FaturatView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ArtikujViewModel}"><v:ArtikujView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KlientetViewModel}"><v:KlientetView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FurnitoretViewModel}"><v:FurnitoretView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RaporteViewModel}"><v:RaporteView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
