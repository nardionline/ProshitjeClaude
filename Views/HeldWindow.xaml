<Window x:Class="MarketPrenga.Views.HeldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Shporta në pritje" Width="520" Height="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Shporta në pritje" Style="{StaticResource H1}" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fshi" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
            <Button Content="Mbyll" IsCancel="True"/>
            <Button Content="Rikthe" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Recall_Click"/>
        </StackPanel>
        <ListBox x:Name="List" DisplayMemberPath="Display" FontSize="15" MouseDoubleClick="List_DoubleClick"
                 BorderBrush="{StaticResource LineBrush}"/>
    </DockPanel>
</Window>
