<UserControl x:Class="MarketPrenga.Views.RaporteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Raporte" Style="{StaticResource H1}" Margin="0,0,0,12"/>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⬇ Eksporto CSV" Command="{Binding ExportCsvCommand}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Nga" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateFrom}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Deri" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateTo}"/>
                    </StackPanel>
                    <Button Content="Gjenero" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Bottom" Margin="12,0,0,14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Xhiro totale" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Total, StringFormat=N2}" Style="{StaticResource BigNumber}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Numri i faturave" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Count}" Style="{StaticResource BigNumber}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Mesatarja për faturë" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Average, StringFormat=N2}" Style="{StaticResource BigNumber}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.RowSpan="3" ItemsSource="{Binding Daily}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dita" Binding="{Binding Dita}" Width="*"/>
                    <DataGridTextColumn Header="Fatura" Binding="{Binding Count}" Width="70"/>
                    <DataGridTextColumn Header="Totali" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2" ItemsSource="{Binding Top}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Artikujt më të shitur" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Sasia" Binding="{Binding Qty, StringFormat=0.###}" Width="90"/>
                    <DataGridTextColumn Header="Totali" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2" Grid.Row="2" ItemsSource="{Binding Users}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sipas përdoruesit" Binding="{Binding User}" Width="*"/>
                    <DataGridTextColumn Header="Fatura" Binding="{Binding Count}" Width="70"/>
                    <DataGridTextColumn Header="Totali" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
