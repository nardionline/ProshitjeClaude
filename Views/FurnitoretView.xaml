<UserControl x:Class="MarketPrenga.Views.FurnitoretView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Furnitorë" Style="{StaticResource H1}" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="2,6,0,0"/>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Emri" Binding="{Binding Emri}" Width="*"/>
                        <DataGridTextColumn Header="Celular" Binding="{Binding Cel}" Width="130"/>
                        <DataGridTextColumn Header="Detyrim" Binding="{Binding Detyrim, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="＋ I ri" Command="{Binding NewCommand}"/>
                            <Button Content="Ruaj" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Fshi" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="Emri" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Emri}"/>
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Tel}"/>
                            <TextBlock Text="Celular" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Cel}"/>
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email}"/>
                            <TextBlock Text="Adresa" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Adresa}"/>
                            <TextBlock Text="Detyrim ndaj furnitorit" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Detyrim}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
