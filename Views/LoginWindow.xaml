<Window x:Class="MarketPrenga.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Hyrje" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="28">
        <Border Style="{StaticResource Card}" Padding="28">
            <StackPanel>
                <TextBlock Text="🛒" FontFamily="Segoe UI Emoji" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Market Prenga" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                <TextBlock Text="Hyr për të vazhduar" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,22"/>

                <TextBlock Text="Përdoruesi" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="UserBox" DisplayMemberPath="Emri"/>

                <TextBlock Text="Fjalëkalimi" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PassBox" KeyDown="PassBox_KeyDown"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button Content="Hyr" IsDefault="True" Click="Login_Click" Style="{StaticResource PrimaryButton}" Padding="14,12"/>
                <Button Content="Dil" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
