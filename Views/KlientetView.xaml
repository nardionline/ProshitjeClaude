<UserControl x:Class="MarketPrenga.Views.KlientetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Klientë" Style="{StaticResource H1}" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="2,6,0,0"/>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Emri" Binding="{Binding Emri}" Width="*"/>
                        <DataGridTextColumn Header="Celular" Binding="{Binding Cel}" Width="130"/>
                        <DataGridTextColumn Header="Borxhi" Binding="{Binding Debi, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="＋ I ri" Command="{Binding NewCommand}"/>
                            <Button Content="Ruaj" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Fshi" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>

                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="Emri dhe mbiemri" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Emri}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Tel}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Cel}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email}"/>
                            <TextBlock Text="Adresa" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Adresa}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Kodi" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Kod}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Shkalla e çmimit" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Rishitesit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Rishites}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Borxhi" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Debi}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pikët e grumbulluara" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Pike}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="💰 Pagesë borxhi" FontWeight="SemiBold" FontFamily="Segoe UI Emoji"/>
                                <TextBox Text="{Binding PayAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"/>
                                <Button Content="Regjistro pagesën" Command="{Binding PayDebtCommand}" Style="{StaticResource SuccessButton}"
                                        FontSize="14" Padding="14,10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
